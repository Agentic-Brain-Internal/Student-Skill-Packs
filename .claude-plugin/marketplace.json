  "plugins": [
    {
      "name": "humanizer",
      "description": "Rewrites text that sounds like AI wrote it so it reads like a person wrote it, without changing what it says.",
      "source": {
        "source": "url",
        "url": "https://github.com/blader/humanizer.git",
        "ref": "main"
      },
      "author": {
        "name": "Siqi Chen",
        "url": "https://github.com/blader"
      },
      "homepage": "https://github.com/blader/humanizer",
      "license": "MIT",
      "category": "writing"
    },
    {
      "name": "stop-slop",
      "description": "A short, strict set of rules for writing that doesn't sound machine-made: cut filler, use active voice, name specific things, vary sentence length, no em dashes.",
      "source": {
        "source": "url",
        "url": "https://github.com/hardikpandya/stop-slop.git",
        "ref": "main"
      },
      "author": {
        "name": "Hardik Pandya",
        "url": "https://hvpandya.com"
      },
      "homepage": "https://github.com/hardikpandya/stop-slop",
      "license": "MIT",
      "category": "writing"
    },
